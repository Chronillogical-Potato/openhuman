# The harness's standing configuration: graph-fused retrieval on, belief
# layers auto-built, per-question salience routing, and consolidation with
# no minimum age (the eval's events are minutes old). Every other profile
# is applied on top of this file and names only what it changes.
# targets: all
# docs: https://cortexdb.ai/docs/operations/recall-tuning
CORTEX_ENTITY_GRAPH=1
CORTEX_V1_LAYERS_AUTO=1
CORTEX_AUTO_ROUTE=1
CORTEX_CONSOLIDATION_MIN_AGE_HOURS=0
